rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Validation Helpers ---
    function isValidWbp(data) {
      return data.keys().hasAll(['nomorRegistrasi', 'nama', 'blokHunian', 'status', 'saldoBerjalan', 'tanggalMasuk']) &&
        data.nomorRegistrasi is string && data.nomorRegistrasi.size() > 0 && data.nomorRegistrasi.size() <= 64 &&
        data.nama is string && data.nama.size() > 0 && data.nama.size() <= 150 &&
        data.blokHunian is string && data.blokHunian.size() <= 150 &&
        data.status in ['Aktif', 'Bebas', 'Mutasi', 'Non-Aktif'] &&
        data.saldoBerjalan is number &&
        data.tanggalMasuk is string && data.tanggalMasuk.size() <= 40;
    }

    function isValidTransaksi(data) {
      return data.keys().hasAll(['nomorTransaksi', 'tanggal', 'wbpId', 'namaWbp', 'jenisTransaksi', 'kategori', 'nominal', 'petugas', 'saldoSetelahTransaksi']) &&
        data.nomorTransaksi is string && data.nomorTransaksi.size() > 0 && data.nomorTransaksi.size() <= 64 &&
        data.tanggal is string && data.tanggal.size() <= 40 &&
        data.wbpId is string && data.wbpId.size() <= 128 &&
        data.namaWbp is string && data.namaWbp.size() <= 150 &&
        data.jenisTransaksi in ['Uang Masuk', 'Uang Keluar'] &&
        data.kategori is string && data.kategori.size() <= 150 &&
        data.nominal is number && data.nominal >= 0 &&
        data.petugas is string && data.petugas.size() <= 150 &&
        data.saldoSetelahTransaksi is number;
    }

    function isValidPengaturan(data) {
      return data.keys().hasAll(['namaUpt', 'namaAplikasi', 'kementerian']) &&
        data.namaUpt is string && data.namaUpt.size() <= 300 &&
        data.namaAplikasi is string && data.namaAplikasi.size() <= 150 &&
        data.kementerian is string && data.kementerian.size() <= 300;
    }

    function isValidLaporan(data) {
      return data.keys().hasAll(['periode', 'tahun', 'bulan', 'status', 'jumlahTransaksi', 'totalMasuk', 'totalKeluar', 'saldoAkhir']) &&
        data.periode is string && data.periode.size() <= 100 &&
        data.tahun is number &&
        data.bulan is number &&
        data.status in ['Bulan Berjalan', 'Tutup Buku Diarsipkan'] &&
        data.jumlahTransaksi is number &&
        data.totalMasuk is number &&
        data.totalKeluar is number &&
        data.saldoAkhir is number;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['timestamp', 'petugas', 'aksi', 'modul', 'rincian', 'tipe']) &&
        data.timestamp is string && data.timestamp.size() <= 50 &&
        data.petugas is string && data.petugas.size() <= 150 &&
        data.aksi is string && data.aksi.size() <= 150 &&
        data.modul is string && data.modul.size() <= 150 &&
        data.rincian is string && data.rincian.size() <= 3000 &&
        data.tipe in ['INFO', 'WARNING', 'DANGER', 'SUCCESS'];
    }

    function isValidKategori(data) {
      return data.keys().hasAll(['nama', 'jenis']) &&
        data.nama is string && data.nama.size() <= 150 &&
        data.jenis in ['Uang Masuk', 'Uang Keluar'];
    }

    // --- Collections ---

    // Pengaturan UPT & Portal
    match /pengaturan_upt/{configId} {
      allow get, list: if true;
      allow write: if isValidId(configId) && isValidPengaturan(incoming());
    }

    // Warga Binaan
    match /warga_binaan/{wbpId} {
      allow get, list: if true;
      allow create, update: if isValidId(wbpId) && isValidWbp(incoming());
      allow delete: if isValidId(wbpId);
    }

    // Transaksi Keuangan
    match /transaksi_uang/{trxId} {
      allow get, list: if true;
      allow create, update: if isValidId(trxId) && isValidTransaksi(incoming());
      allow delete: if isValidId(trxId);
    }

    // Laporan Bulanan
    match /laporan_bulanan/{reportId} {
      allow get, list: if true;
      allow create, update: if isValidId(reportId) && isValidLaporan(incoming());
      allow delete: if isValidId(reportId);
    }

    // Audit Logs (Immutable)
    match /audit_logs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // Kategori
    match /kategori/{catId} {
      allow get, list: if true;
      allow create, update: if isValidId(catId) && isValidKategori(incoming());
      allow delete: if isValidId(catId);
    }

    // Admins
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId);
    }
  }
}
